{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "http-trax",
  "identifier": "dev.httptrax.app",
  "build": {
    "beforeDevCommand": "npm run sidecar:debug && npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run sidecar && npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "http-trax",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Git-native API client",
    "longDescription": "http-trax is an API client with git-backed workspaces, JavaScript pre/post-request scripts and an MCP server so AI agents can test the services they build.",
    "externalBin": [
      "binaries/trax-mcp"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "git"
        ]
      },
      "rpm": {
        "depends": [
          "git"
        ]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
